<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.1//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_2.dtd'>
<nta>
	<declaration>// G1 pedestrian-request traffic-light model. All time units are seconds.
clock phaseClock;
clock waitClock;

chan walkStart;
chan walkDone;

bool requestPending = false;
bool pedestrianCrossing = false;

const int CAR_GREEN = 0;
const int CAR_YELLOW = 1;
const int ALL_RED = 2;
const int PED_GREEN = 3;
int[0,3] signal = CAR_GREEN;

const int CAR_GREEN_MIN = 5;
const int CAR_GREEN_MAX = 10;
const int YELLOW_DURATION = 2;
const int ALL_RED_DURATION = 1;
const int ARRIVAL_MIN = 1;
const int ARRIVAL_MAX = 4;
const int CROSSING_MIN = 3;
const int CROSSING_MAX = 4;

// Worst case: request at t=1, vehicle green ends at t=10,
// then 2 seconds yellow and 1 second all-red clearance.
const int WAIT_BOUND = 12;</declaration>
	<template>
		<name x="0" y="0">TrafficLight</name>
		<location id="c_car_green" x="0" y="0">
			<name x="-35" y="-34">CarGreen</name>
			<label kind="invariant" x="-85" y="17">phaseClock &lt;= CAR_GREEN_MAX</label>
		</location>
		<location id="c_car_yellow" x="250" y="0">
			<name x="211" y="-34">CarYellow</name>
			<label kind="invariant" x="190" y="17">phaseClock &lt;= YELLOW_DURATION</label>
		</location>
		<location id="c_all_red_before" x="500" y="0">
			<name x="445" y="-34">AllRedBeforeWalk</name>
			<label kind="invariant" x="440" y="17">phaseClock &lt;= ALL_RED_DURATION</label>
		</location>
		<location id="c_ped_green" x="750" y="0">
			<name x="705" y="-34">PedestrianGreen</name>
			<label kind="invariant" x="690" y="17">phaseClock &lt;= CROSSING_MAX</label>
		</location>
		<location id="c_all_red_after" x="500" y="180">
			<name x="445" y="197">AllRedAfterWalk</name>
			<label kind="invariant" x="440" y="214">phaseClock &lt;= ALL_RED_DURATION</label>
		</location>
		<init ref="c_car_green"/>
		<transition>
			<source ref="c_car_green"/>
			<target ref="c_car_yellow"/>
			<label kind="guard" x="45" y="-75">requestPending &amp;&amp; phaseClock &gt;= CAR_GREEN_MIN</label>
			<label kind="assignment" x="55" y="-58">phaseClock = 0, signal = CAR_YELLOW</label>
		</transition>
		<transition>
			<source ref="c_car_green"/>
			<target ref="c_car_green"/>
			<label kind="guard" x="-220" y="70">!requestPending &amp;&amp; phaseClock &gt;= CAR_GREEN_MAX</label>
			<label kind="assignment" x="-220" y="87">phaseClock = 0</label>
			<nail x="-110" y="120"/>
			<nail x="110" y="120"/>
		</transition>
		<transition>
			<source ref="c_car_yellow"/>
			<target ref="c_all_red_before"/>
			<label kind="guard" x="300" y="-75">phaseClock &gt;= YELLOW_DURATION</label>
			<label kind="assignment" x="300" y="-58">phaseClock = 0, signal = ALL_RED</label>
		</transition>
		<transition>
			<source ref="c_all_red_before"/>
			<target ref="c_ped_green"/>
			<label kind="guard" x="550" y="-92">phaseClock &gt;= ALL_RED_DURATION</label>
			<label kind="synchronisation" x="585" y="-75">walkStart!</label>
			<label kind="assignment" x="550" y="-58">phaseClock = 0, signal = PED_GREEN</label>
		</transition>
		<transition>
			<source ref="c_ped_green"/>
			<target ref="c_all_red_after"/>
			<label kind="synchronisation" x="650" y="95">walkDone?</label>
			<label kind="assignment" x="555" y="112">phaseClock = 0, signal = ALL_RED, requestPending = false</label>
		</transition>
		<transition>
			<source ref="c_all_red_after"/>
			<target ref="c_car_green"/>
			<label kind="guard" x="145" y="245">phaseClock &gt;= ALL_RED_DURATION</label>
			<label kind="assignment" x="145" y="262">phaseClock = 0, signal = CAR_GREEN</label>
			<nail x="250" y="180"/>
			<nail x="0" y="180"/>
		</transition>
	</template>
	<template>
		<name x="0" y="340">Pedestrian</name>
		<declaration>clock arrivalClock;
clock crossingClock;</declaration>
		<location id="p_approach" x="0" y="400">
			<name x="-28" y="366">Approach</name>
			<label kind="invariant" x="-55" y="417">arrivalClock &lt;= ARRIVAL_MAX</label>
		</location>
		<location id="p_waiting" x="250" y="400">
			<name x="228" y="366">Waiting</name>
		</location>
		<location id="p_crossing" x="500" y="400">
			<name x="474" y="366">Crossing</name>
			<label kind="invariant" x="445" y="417">crossingClock &lt;= CROSSING_MAX</label>
		</location>
		<location id="p_done" x="750" y="400">
			<name x="733" y="366">Done</name>
		</location>
		<init ref="p_approach"/>
		<transition>
			<source ref="p_approach"/>
			<target ref="p_waiting"/>
			<label kind="guard" x="60" y="325">arrivalClock &gt;= ARRIVAL_MIN</label>
			<label kind="assignment" x="55" y="342">requestPending = true, waitClock = 0</label>
		</transition>
		<transition>
			<source ref="p_waiting"/>
			<target ref="p_crossing"/>
			<label kind="synchronisation" x="335" y="325">walkStart?</label>
			<label kind="assignment" x="300" y="342">crossingClock = 0, pedestrianCrossing = true</label>
		</transition>
		<transition>
			<source ref="p_crossing"/>
			<target ref="p_done"/>
			<label kind="guard" x="560" y="308">crossingClock &gt;= CROSSING_MIN</label>
			<label kind="synchronisation" x="605" y="325">walkDone!</label>
			<label kind="assignment" x="570" y="342">pedestrianCrossing = false</label>
		</transition>
	</template>
	<system>Controller = TrafficLight();
PedestrianProcess = Pedestrian();
system Controller, PedestrianProcess;</system>
	<queries>
		<query>
			<formula>A[] not deadlock</formula>
			<comment>所有可达状态均无死锁。</comment>
		</query>
		<query>
			<formula>A[] (PedestrianProcess.Crossing imply signal == PED_GREEN)</formula>
			<comment>行人穿越时必须显示行人绿灯。</comment>
		</query>
		<query>
			<formula>A[] (pedestrianCrossing imply Controller.PedestrianGreen)</formula>
			<comment>占用标志为真时控制器必须处于行人绿灯位置。</comment>
		</query>
		<query>
			<formula>A[] not (PedestrianProcess.Crossing &amp;&amp; Controller.CarGreen)</formula>
			<comment>行人穿越与车辆绿灯不能同时发生。</comment>
		</query>
		<query>
			<formula>E&lt;&gt; PedestrianProcess.Done</formula>
			<comment>至少存在一条行人完成通行的路径。</comment>
		</query>
		<query>
			<formula>PedestrianProcess.Waiting --&gt; PedestrianProcess.Done</formula>
			<comment>每次进入等待状态后最终都会完成通行。</comment>
		</query>
		<query>
			<formula>A[] (PedestrianProcess.Waiting imply waitClock &lt;= WAIT_BOUND)</formula>
			<comment>行人等待时间不超过推导出的 12 秒上界。</comment>
		</query>
		<query>
			<formula>A[] (PedestrianProcess.Crossing imply crossingClock &lt;= CROSSING_MAX)</formula>
			<comment>穿越时间不超过 4 秒。</comment>
		</query>
	</queries>
</nta>
