<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC "-//Uppaal Team//DTD Flat System 1.1//EN" "http://www.it.uu.se/research/group/darts/uppaal/flat-1_1.dtd">
<nta>
  <declaration>
clock lightClock;
int[0,2] lightState = 2;
bool crossing = false;
  </declaration>

  <template>
    <name>TrafficLight</name>
    <declaration></declaration>

    <location id="tl_init" x="0" y="0">
      <name x="-15" y="-30">Init</name>
      <committed/>
    </location>
    <location id="tl_green" x="200" y="0">
      <name x="180" y="-50">Green</name>
      <label kind="invariant" x="150" y="-30">lightClock &lt;= 20</label>
    </location>
    <location id="tl_yellow" x="400" y="0">
      <name x="380" y="-50">Yellow</name>
      <label kind="invariant" x="350" y="-30">lightClock &lt;= 3</label>
    </location>
    <location id="tl_red" x="300" y="200">
      <name x="280" y="220">Red</name>
      <label kind="invariant" x="250" y="240">lightClock &lt;= 20</label>
    </location>

    <init ref="tl_init"/>

    <transition>
      <source ref="tl_init"/>
      <target ref="tl_green"/>
      <label kind="assignment" x="20" y="20">lightClock = 0, lightState = 0</label>
    </transition>
    <transition>
      <source ref="tl_green"/>
      <target ref="tl_yellow"/>
      <label kind="guard" x="220" y="-100">lightClock &gt;= 20 &amp;&amp; !crossing</label>
      <label kind="assignment" x="220" y="-80">lightClock = 0, lightState = 1</label>
    </transition>
    <transition>
      <source ref="tl_yellow"/>
      <target ref="tl_red"/>
      <label kind="guard" x="380" y="80">lightClock &gt;= 3</label>
      <label kind="assignment" x="380" y="100">lightClock = 0, lightState = 2</label>
    </transition>
    <transition>
      <source ref="tl_red"/>
      <target ref="tl_green"/>
      <label kind="guard" x="70" y="100">lightClock &gt;= 20</label>
      <label kind="assignment" x="70" y="120">lightClock = 0, lightState = 0</label>
    </transition>
  </template>

  <template>
    <name>Vehicle</name>
    <declaration>
clock arrivalClock;
clock crossingClock;
    </declaration>

    <location id="v_init" x="0" y="0">
      <name x="-15" y="-30">Init</name>
      <committed/>
    </location>
    <location id="v_approaching" x="200" y="0">
      <name x="160" y="-50">Approaching</name>
      <label kind="invariant" x="150" y="-30">arrivalClock &lt;= 5</label>
    </location>
    <location id="v_waiting" x="400" y="0">
      <name x="375" y="-30">Waiting</name>
    </location>
    <location id="v_crossing" x="600" y="0">
      <name x="570" y="-50">Crossing</name>
      <label kind="invariant" x="550" y="-30">crossingClock &lt;= 3</label>
    </location>
    <location id="v_done" x="800" y="0">
      <name x="780" y="-30">Done</name>
    </location>

    <init ref="v_init"/>

    <transition>
      <source ref="v_init"/>
      <target ref="v_approaching"/>
      <label kind="assignment" x="30" y="20">arrivalClock = 0</label>
    </transition>
    <transition>
      <source ref="v_approaching"/>
      <target ref="v_waiting"/>
      <label kind="guard" x="230" y="20">arrivalClock &gt;= 1 &amp;&amp; arrivalClock &lt;= 5</label>
    </transition>
    <transition>
      <source ref="v_waiting"/>
      <target ref="v_crossing"/>
      <label kind="guard" x="410" y="-100">lightState == 0 &amp;&amp; lightClock &lt;= 17</label>
      <label kind="assignment" x="410" y="-80">crossingClock = 0, crossing = true</label>
    </transition>
    <transition>
      <source ref="v_crossing"/>
      <target ref="v_done"/>
      <label kind="guard" x="620" y="20">crossingClock &gt;= 2 &amp;&amp; crossingClock &lt;= 3</label>
      <label kind="assignment" x="620" y="40">crossing = false</label>
    </transition>
  </template>

  <system>
TL = TrafficLight();
V = Vehicle();
system TL, V;
  </system>

  <queries>
    <query>
      <formula>A[] not deadlock</formula>
      <comment></comment>
    </query>
    <query>
      <formula>A[] (V.Crossing imply TL.Green)</formula>
      <comment></comment>
    </query>
    <query>
      <formula>A[] (V.Crossing imply (lightState == 0 &amp;&amp; crossing))</formula>
      <comment></comment>
    </query>
    <query>
      <formula>E&lt;&gt; V.Done</formula>
      <comment></comment>
    </query>
    <query>
      <formula>A&lt;&gt; V.Done</formula>
      <comment></comment>
    </query>
    <query>
      <formula>V.Waiting --&gt; V.Done</formula>
      <comment></comment>
    </query>
  </queries>
</nta>